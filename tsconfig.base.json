{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@fitoverforty/admin-angular-data-access": [
        "libs/admin/angular/data-access/src/index.ts"
      ],
      "@fitoverforty/admin-angular-feature": [
        "libs/admin/angular/feature/src/index.ts"
      ],
      "@fitoverforty/admin-angular-feature/*": [
        "libs/admin/angular/feature/src/lib/*"
      ],
      "@fitoverforty/blog-angular-data-access": [
        "libs/blog/angular/data-access/src/index.ts"
      ],
      "@fitoverforty/blog-angular-feature": [
        "libs/blog/angular/feature/src/index.ts"
      ],
      "@fitoverforty/blog-angular-feature/*": [
        "libs/blog/angular/feature/src/lib/*"
      ],
      "@fitoverforty/blog-angular-ui": ["libs/blog/angular/ui/src/index.ts"],
      "@fitoverforty/blog-ts": ["libs/blog/ts/src/index.ts"],
      "@fitoverforty/common-angular-ui": [
        "libs/common/angular/ui/src/index.ts"
      ],
      "@fitoverforty/editorjs-angular": ["libs/editorjs/angular/src/index.ts"],
      "@fitoverforty/legal-angular": ["libs/legal/angular/src/index.ts"],
      "@fitoverforty/newsletter-angular": [
        "libs/newsletter/angular/src/index.ts"
      ],
      "@fitoverforty/seo-angular": ["libs/seo/angular/src/index.ts"],
      "@fitoverforty/newsletter-nest": ["libs/newsletter/nest/src/index.ts"],
      "@fitoverforty/auth-nest": ["libs/auth/nest/src/index.ts"],
      "@fitoverforty/blog-nest": ["libs/blog/nest/src/index.ts"],
      "@fitoverforty/media-nest": ["libs/media/nest/src/index.ts"],
      "@fitoverforty/og-nest": ["libs/og/nest/src/index.ts"]
    },
    "noUncheckedSideEffectImports": false,
    "types": ["*"],
    "ignoreDeprecations": "6.0"
  },
  "exclude": ["node_modules", "tmp"]
}
