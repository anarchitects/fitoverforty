{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2015",
    "module": "esnext",
    "lib": ["es2020", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@fitoverforty/frontend-header": ["libs/frontend/header/src/index.ts"],
      "@fitoverforty/frontend-footer": ["libs/frontend/footer/src/index.ts"],
      "@fitoverforty/content-model": ["libs/shared/content-model/src/index.ts"],
      "@fitoverforty/frontend-blog": ["libs/frontend/blog/src/index.ts"],
      "@fitoverforty/frontend-editorjs": [
        "libs/frontend/editorjs/src/index.ts"
      ],
      "@fitoverforty/seo-angular": ["libs/seo/angular/src/index.ts"],
      "@fitoverforty/newsletter-angular": [
        "libs/newsletter/angular/src/index.ts"
      ]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
