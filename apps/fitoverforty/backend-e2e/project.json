{
  "name": "fitoverforty-backend-e2e",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "implicitDependencies": ["fitoverforty-backend"],
  "targets": {
    "e2e": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{e2eProjectRoot}"],
      "options": {
        "jestConfig": "apps/fitoverforty/backend-e2e/jest.config.cts",
        "passWithNoTests": true
      },
      "dependsOn": ["fitoverforty-backend:build", "fitoverforty-backend:serve"]
    }
  }
}
