{
  "name": "fitoverforty-backend",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "apps/fitoverforty/backend/src",
  "projectType": "application",
  "tags": ["scope: backend"],
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "webpack-cli build",
        "args": ["--config-node-env=production"],
        "cwd": "apps/fitoverforty/backend"
      },
      "configurations": {
        "development": {
          "args": ["--config-node-env=development"]
        }
      }
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/fitoverforty/backend/jest.config.cts",
        "passWithNoTests": true
      }
    },
    "serve": {
      "continuous": true,
      "executor": "@nx/js:node",
      "defaultConfiguration": "development",
      "dependsOn": ["build"],
      "options": {
        "buildTarget": "fitoverforty-backend:build",
        "runBuildTargetDependencies": false
      },
      "configurations": {
        "development": {
          "buildTarget": "fitoverforty-backend:build:development"
        },
        "production": {
          "buildTarget": "fitoverforty-backend:build:production"
        }
      }
    },
    "create-admin": {
      "executor": "nx:run-commands",
      "options": {
        "command": "ts-node -r tsconfig-paths/register -P apps/fitoverforty/backend/tsconfig.app.json apps/fitoverforty/backend/src/create-admin.ts",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
