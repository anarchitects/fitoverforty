# Connection is configured with discrete TYPEORM_* variables.
# DATABASE_URL is not read by src/data-source.ts.

TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=fitoverforty
TYPEORM_PASSWORD=fitoverforty
TYPEORM_DATABASE=fitoverforty
TYPEORM_SCHEMA=public
TYPEORM_SSL=false
# TYPEORM_SSL can also be a JSON object:
# TYPEORM_SSL={"rejectUnauthorized":false}
TYPEORM_APPLICATION_NAME=fitoverforty_backend-service
TYPEORM_CONNECT_TIMEOUT_MS=5000

# --- Mail delivery -----------------------------------------------------------
# Read by CommonMailerModule.forRootFromConfig() in app.module.ts. Every value
# below has a placeholder default (smtp.example.com etc.), so leaving these
# unset does not disable mail - it makes delivery fail at send time.
#
# Local development: `docker compose up mailpit` provides an SMTP sink on 1025
# with a web UI on http://localhost:8025. The values below point at it.

# 'node' sends over SMTP, 'noop' discards silently. Any other value throws at
# startup. Default: node
MAILER_PROVIDER=node
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_SECURE=false
MAILER_IGNORE_TLS=true
# Mailpit accepts any credentials; a real SMTP provider will not.
# MAILER_USER=
# MAILER_PASS=
# Envelope From for outbound mail.
MAILER_DEFAULT=noreply@fitoverforty.blog
# Directory holding the Handlebars templates referenced by form configs
# (contact-form-notification, contact-form-autoreply). Relative paths resolve
# against the process working directory, so an absolute path is safer when
# running the built output. Default: templates
MAILER_TEMPLATE_DIR=apps/fitoverforty/backend/src/assets/email-templates

# --- Forms -------------------------------------------------------------------
# Read by FormsModule.forRootFromConfig(). Mirrors MAILER_PROVIDER and is what
# the e2e suite sets to 'noop' so tests never touch SMTP. Default: node
FORMS_MAILER_PROVIDER=node
# Persistence driver for form configs and submissions. Default: typeorm
# FORMS_PERSISTENCE=typeorm

# Angular SSR (optional).
# Set both to have this process server-render the Angular app; leave either
# unset and the server runs API-only. Paths point at the separately-built
# frontend output, since frontend and backend are distinct Nx projects.
WEB_SERVER_ENTRY=dist/apps/fitoverforty/frontend/server/server.mjs
WEB_BROWSER_ASSETS_DIR=dist/apps/fitoverforty/frontend/browser
# Hostnames Angular's SSR engine will render for (SSRF guard). Comma-separated.
WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Site ----------------------------------------------------------------------
# Public origin, used for absolute URLs in the RSS feed, the sitemap, robots.txt
# and every canonical/OpenGraph tag.
#
# Behind a proxy this must be set: the request's own host is the internal one,
# so canonical URLs would otherwise point somewhere unreachable. When unset it
# falls back to the incoming request, which is fine locally.
SITE_URL=http://localhost:4200

# --- Newsletter (MailerLite) ---------------------------------------------------
# Unlike MAILER_* above, these have no placeholder defaults, and that is
# deliberate. Leave BOTH unset and the newsletter is disabled: consent is still
# recorded, nobody is subscribed, and the app says so at boot. Set only ONE and
# the app refuses to start, rather than failing at the first subscription.
#
# The key is server-side only and must never reach the browser.
# MAILERLITE_API_KEY=
# Find it in the MailerLite dashboard under Subscribers > Groups - it is the
# number at the end of the group's URL.
# MAILERLITE_GROUP_ID=
# Override only for testing against a stub.
# MAILERLITE_API_URL=https://connect.mailerlite.com/api/subscribers
#
# NOTE: double opt-in must be enabled on that group in the MailerLite UI.
# Nothing here or in CI can verify it, and the lawful basis for these emails
# depends on it.

# --- Admin authentication (Better Auth) ----------------------------------------
# Signs session cookies. REQUIRED: the backend refuses to start without it, and
# that refusal is deliberate — unlike MAILER_* above, there is no placeholder
# default, because a known secret means anyone who can read this repository can
# mint a valid admin session.
#
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Accounts are NOT seeded. Create them yourself, once, with:
#   corepack yarn nx run fitoverforty-backend:create-admin
# It prompts for the password without echoing it, and hashes it through Better
# Auth itself so sign-in can verify it. Public sign-up is disabled.
