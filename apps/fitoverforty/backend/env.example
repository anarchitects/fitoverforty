# Connection is configured with discrete TYPEORM_* variables.
# DATABASE_URL is not read by src/data-source.ts.

TYPEORM_HOST=localhost
TYPEORM_PORT=5432
TYPEORM_USERNAME=fitoverforty
TYPEORM_PASSWORD=fitoverforty
TYPEORM_DATABASE=fitoverforty
TYPEORM_SCHEMA=public
TYPEORM_SSL=false
# TYPEORM_SSL can also be a JSON object:
# TYPEORM_SSL={"rejectUnauthorized":false}
#
# What the app logs. Defaults to error, warn and migration: successful queries
# are silent, failing ones still print their SQL, which is what makes a broken
# migration diagnosable. Set "all" to get every query back while debugging, a
# comma-separated list of TypeORM's levels for something between, or "false"
# for silence. The db:migrate:* targets ignore this — TypeORM's own migration
# command overrides it.
# TYPEORM_LOGGING=all
TYPEORM_APPLICATION_NAME=fitoverforty_backend-service
TYPEORM_CONNECT_TIMEOUT_MS=5000

# --- Mail delivery -----------------------------------------------------------
# Read by CommonMailerModule.forRootFromConfig() in app.module.ts. Every value
# below has a placeholder default (smtp.example.com etc.), so leaving these
# unset does not disable mail - it makes delivery fail at send time.
#
# Local development: `docker compose up mailpit` provides an SMTP sink on 1025
# with a web UI on http://localhost:8025. The values below point at it.

# 'node' sends over SMTP, 'noop' discards silently. Any other value throws at
# startup. Default: node
MAILER_PROVIDER=node
MAILER_HOST=localhost
MAILER_PORT=1025
MAILER_SECURE=false
MAILER_IGNORE_TLS=true
# Mailpit accepts any credentials; a real SMTP provider will not.
# MAILER_USER=
# MAILER_PASS=
# Envelope From for outbound mail.
MAILER_DEFAULT=noreply@fitoverforty.blog
# Directory holding the Handlebars templates referenced by form configs
# (contact-form-notification, contact-form-autoreply). Relative paths resolve
# against the process working directory, so an absolute path is safer when
# running the built output. Default: templates
MAILER_TEMPLATE_DIR=apps/fitoverforty/backend/src/assets/email-templates

# --- Forms -------------------------------------------------------------------
# Read by FormsModule.forRootFromConfig(). Mirrors MAILER_PROVIDER and is what
# the e2e suite sets to 'noop' so tests never touch SMTP. Default: node
FORMS_MAILER_PROVIDER=node
# Persistence driver for form configs and submissions. Default: typeorm
# FORMS_PERSISTENCE=typeorm

# Angular SSR (optional).
# Set both to have this process server-render the Angular app; leave either
# unset and the server runs API-only. Paths point at the separately-built
# frontend output, since frontend and backend are distinct Nx projects.
WEB_SERVER_ENTRY=dist/apps/fitoverforty/frontend/server/server.mjs
WEB_BROWSER_ASSETS_DIR=dist/apps/fitoverforty/frontend/browser
# Hostnames Angular's SSR engine will render for (SSRF guard). Comma-separated.
#
# This default is a development one and does not survive deployment: behind a
# proxy the Host header carries the public name, which is not in this list, and
# the engine answers 400 to *every* page request. Not a subtle degradation —
# the site is down. Set it to the public hostname when deploying.
WEB_ALLOWED_HOSTS=localhost,127.0.0.1

# Where server-side rendering sends the app's own API calls. Optional, and
# normally left unset: the renderer and the API are the same process, so the
# default is loopback on PORT.
#
# It must not be the public origin. Behind Nginx the incoming request's origin
# is https://the-public-name, and rendering a page through that sends the fetch
# out of the machine and back in through the proxy — which needs the server to
# resolve its own public name and trust its own certificate, and costs a
# network round trip per render when it does work. Set this only where the API
# genuinely is a different process.
# API_ORIGIN=http://127.0.0.1:3000

# --- Site ----------------------------------------------------------------------
# REQUIRED. The backend refuses to start without it.
#
# Public origin, used for absolute URLs in the RSS feed, the sitemap, robots.txt
# and every canonical/OpenGraph tag -- and, more sharply, it is the ONLY origin
# Better Auth trusts to drive the admin login, plus the base for session
# cookies. It has no development default for that reason: one would mean a
# deployed instance trusting localhost for ever.
#
# Behind a proxy it must match the public origin, not the internal one the
# request arrives on, or canonical URLs point somewhere unreachable.
SITE_URL=http://localhost:4200

# Whether this instance wants to be in search results. Off unless set to
# exactly "true"; "1" and "yes" are off.
#
# Unset, every response carries `X-Robots-Tag: noindex, nofollow` and
# robots.txt stops advertising the sitemap. That is the right default for
# staging, a local machine and anything else temporary: staging serves the same
# content as production under a second hostname AND emits its own canonical
# tag pointing at itself, so left alone it does not just get crawled, it tells
# a crawler it is the real site. Two of those competing in an index is slow to
# notice and slower to undo.
#
# SET THIS TO true ON THE PUBLIC SITE. Forgetting it is not a broken page --
# every URL answers perfectly and none of them can appear in search. The boot
# log says which mode the process is in, and /robots.txt says so too.
#
# Note it does not add `Disallow: /`, which would be self-defeating: a crawler
# told not to fetch a page never reads the noindex on it, and can still list
# the URL from someone else's link.
# ALLOW_INDEXING=true

# --- Newsletter (MailerLite) ---------------------------------------------------
# Unlike MAILER_* above, these have no placeholder defaults, and that is
# deliberate. Leave BOTH unset and the newsletter is disabled: consent is still
# recorded, nobody is subscribed, and the app says so at boot. Set only ONE and
# the app refuses to start, rather than failing at the first subscription.
#
# The key is server-side only and must never reach the browser.
# MAILERLITE_API_KEY=
# Find it in the MailerLite dashboard under Subscribers > Groups - it is the
# number at the end of the group's URL.
# MAILERLITE_GROUP_ID=
# Override only for testing against a stub.
# MAILERLITE_API_URL=https://connect.mailerlite.com/api/subscribers
#
# The signing secret for the unsubscribe webhook. This is NOT the API key: the
# v3 API generates a separate secret per webhook, shown once when you create it
# in the MailerLite dashboard under Integrations > Webhooks. Point that webhook
# at POST /api/newsletter/webhook and subscribe it to subscriber.unsubscribed
# and subscriber.deleted.
#
# Unset is allowed and separate from the two above: an app can be configured to
# send and not yet to receive. The endpoint then answers 503 — retryable, so
# events queued during the gap are not lost — and unsubscribes are not mirrored
# into the consent log until it is set.
#
# Expect it to be unset in development. A webhook needs a publicly reachable
# URL, and MailerLite cannot call localhost, so there is nothing to create one
# against until the app is deployed.
# MAILERLITE_WEBHOOK_SECRET=
#
# NOTE: double opt-in must be enabled on that group in the MailerLite UI.
# Nothing here or in CI can verify it, and the lawful basis for these emails
# depends on it.

# --- Admin authentication (Better Auth) ----------------------------------------
# Signs session cookies. REQUIRED: the backend refuses to start without it, and
# that refusal is deliberate — unlike MAILER_* above, there is no placeholder
# default, because a known secret means anyone who can read this repository can
# mint a valid admin session.
#
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# Accounts are NOT seeded. Create them yourself, once, with:
#   corepack yarn nx run fitoverforty-backend:create-admin
# It prompts for the password without echoing it, and hashes it through Better
# Auth itself so sign-in can verify it. Public sign-up is disabled.

# --- Media uploads -------------------------------------------------------------
# Where uploaded images are written. Relative paths resolve against the
# workspace root. Deliberately outside dist/ so a rebuild does not delete what
# authors have uploaded, and outside the frontend's assets so nothing is served
# by a static handler — every file leaves through the media controller, which
# sets the content type recorded at upload plus X-Content-Type-Options: nosniff.
#
# Local disk is a development answer. Production wants object storage, which is
# a swap of the MEDIA_STORAGE provider in MediaModule and no change anywhere
# else. The bucket and credentials are still an open question — see spec §16.
MEDIA_ROOT=.data/media
